{
  "name": "seta-agente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "docker compose -f infra/compose.dev.yml up -d --wait && tsc -b && pnpm db:migrate && pnpm run '/^dev:/'",
    "dev:tsc": "tsc -b --watch --preserveWatchOutput",
    "dev:server": "node --watch --env-file-if-exists=.env apps/server/dist/index.js",
    "dev:console": "pnpm --filter @seta/console dev",
    "dev-whatsapp": "tools/dev-whatsapp.sh",
    "build": "tsc -b && pnpm --filter @seta/console build",
    "typecheck": "tsc -b && pnpm --filter @seta/console typecheck",
    "test": "tsc -b && vitest run",
    "lint": "biome check . && depcruise apps packages",
    "db:migrate": "pnpm --filter @seta/server db:migrate",
    "db:seed": "pnpm db:seed:erp && pnpm --filter @seta/server db:seed:app",
    "db:seed:erp": "tsc -b && node --env-file-if-exists=.env infra/erp-mock/seed.ts",
    "kb:ingest": "tsc -b && pnpm --filter @seta/server kb:ingest",
    "demo:seed": "pnpm db:seed && pnpm kb:ingest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@seta/erp-connector": "workspace:*",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.2.0",
    "pg": "^8.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
