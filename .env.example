# Copie para .env (nunca commitar o .env)
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Banco do produto (rw) — ver infra/postgres/init/01-init.sql
DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:5432/app

# ERP simulado (somente leitura, só enxerga as views canônicas)
ERP_DATABASE_URL=postgres://erp_ro:erp_ro_dev@localhost:5432/erp_mock

# Admin do erp_mock — SÓ para tooling dev (db:seed:erp aplica schema e seed)
ERP_MOCK_ADMIN_URL=postgres://postgres:postgres@localhost:5432/erp_mock

# Config da implantação (1 cliente na POC)
CLIENT_CONFIG_PATH=configs/demo/client.yaml
# Catálogo de queries (003), vínculos wa_id→contrato do seed (007) e skills escritas à mão (009)
CATALOG_DIR=catalog
CONTATOS_PATH=configs/demo/contatos.yaml
SKILLS_SEED_DIR=skills-seed

# Console HITL (Better Auth). Em NODE_ENV=production o boot RECUSA o secret de dev (P-28)
BETTER_AUTH_SECRET=dev-secret-trocar-em-prod
BETTER_AUTH_URL=http://localhost:3001

# Produção (compose.prod.yml, via .env.prod — nunca aqui): POSTGRES_PASSWORD,
# APP_OWNER_PASSWORD e ERP_RO_PASSWORD; DATABASE_URL/ERP_DATABASE_URL com essas senhas.
# O server recusa subir em produção com app_owner_dev/erp_ro_dev na URL (P-29).

# WhatsApp Meta Cloud API — ver docs/meta-setup.md
# Simulador dev (plano B da demo): habilita POST /dev/inbound e GET /dev/events
DEV_SIMULATOR=true
# Token arbitrário usado na verificação do webhook (GET /webhook)
WA_VERIFY_TOKEN=dev-verify-token
# App secret do app Meta (valida X-Hub-Signature-256 do POST /webhook)
WA_APP_SECRET=dev-app-secret
# Credenciais da Cloud API; ausentes ⇒ envio vira log-only (dev/simulador)
#WA_ACCESS_TOKEN=
#WA_PHONE_NUMBER_ID=
# 013: id da WhatsApp Business Account — habilita criar/sincronizar modelos de
# mensagem (templates) direto da plataforma
#WA_WABA_ID=
# Silêncio (ms) que fecha um turno no debouncer (#46: base 10s; a janela se
# adapta — mensagem com fecho ?!. espera 0.6x, continuação/curta espera 1.5x)
WA_DEBOUNCE_MS=10000

# Provedor LLM (endpoint OpenAI-compatible: OpenAI, OpenRouter, vLLM on-prem...)
# Ausente ⇒ agente responde fallback honesto (simulador continua funcionando)
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_API_KEY=
#LLM_MODEL=
#EMBEDDING_MODEL=
# Dimensão dos embeddings (default 1536 = text-embedding-3-small); precisa casar
# com o EMBEDDING_MODEL — o índice HNSW e a validação do store usam esse valor
#EMBEDDING_DIM=1536
# Preço por 1M de tokens (custo estimado em /metricas; unidade livre, ex.: USD)
LLM_PRECO_IN_POR_1M=0
LLM_PRECO_OUT_POR_1M=0
# Timeout do turno do agente (ms), cadência do resumo rolante (turnos) e turnos
# de conversas DIFERENTES processados em paralelo (#28)
AGENT_TURN_TIMEOUT_MS=60000
AGENT_RESUMO_A_CADA_TURNOS=4
AGENT_TURNOS_CONCORRENTES=3

# Base de conhecimento (008): pasta de .md ingerida por `pnpm kb:ingest`
KB_DIR=kb

# SDR para lead frio (015): alçada em basis points sobre o valor de tabela da
# cota (300 = 3%); acima disso a proposta espera validação humana
SDR_DESCONTO_MAX_BPS=300
SDR_FLUXO_EXPIRA_MIN=60
SDR_MAX_PROPOSTAS_DIA=3

# Anonimização (016): PII do texto livre (CPF, CNPJ, telefone, e-mail, CEP, cartão,
# placa, nome) vira token estável antes de sair para a LLM e volta na resposta.
# Ligada por default — desligar é decisão explícita
LLM_ANONIMIZAR=true
# NER local (nomes em qualquer posição) via @huggingface/transformers; sem o modelo
# no cache o boot segue só com regex + dicionário e loga
ANONIMIZACAO_NER=true
ANONIMIZACAO_NER_MODELO=Xenova/distilbert-base-multilingual-cased-ner-hrl
# Cache dos modelos; `pnpm anonimizacao:modelo` baixa (~135 MB); a imagem já traz
ANONIMIZACAO_MODELOS_DIR=.modelos
ANONIMIZACAO_NER_DOWNLOAD=true

# Pagamentos (014, ADR 0001) — Asaas via API; ver docs/asaas-setup.md
# Sem ASAAS_API_KEY o server usa o PSP SIMULADO (links/códigos fictícios; boot loga `psp: simulado`)
# O AMBIENTE (sandbox x produção) sai desta URL, não da chave — nunca as misture
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ENTRE ASPAS SIMPLES: a chave começa com `$` e o tools/dev-whatsapp.sh sourceia este
# arquivo pelo shell — sem aspas ela é expandida para vazio e o webhook não é registrado
#ASAAS_API_KEY='$aact_hmlg_...'
# Token (32..255 chars) que o Asaas envia no header asaas-access-token; ausente ⇒ POST /webhooks/asaas responde 503
#ASAAS_WEBHOOK_TOKEN=
# 043: modelo aprovado com botão order_details para mandar a cobrança fora da janela de 24h.
# Ausente ⇒ janela fechada volta ao comportamento da 014 (marca janela_fechada + ticket).
# O recebedor do PIX (nome, chave, tipo) fica em configs/demo/client.yaml, não aqui.
#WA_TEMPLATE_COBRANCA_PIX=cobranca_pix
#WA_TEMPLATE_COBRANCA_BOLETO=cobranca_boleto
#WA_TEMPLATE_BOLETO_SEGUNDA_VIA=boleto_segunda_via
#WA_TEMPLATE_COBRANCA_CARTAO=cobranca_cartao
# E-mail do cadastro do webhook (só o tools/dev-whatsapp.sh usa, ao registrar o webhook pelo túnel)
#ASAAS_WEBHOOK_EMAIL=
# Acima deste valor (centavos) a cobrança espera aprovação de um atendente no console
PAGAMENTO_TETO_SEM_HITL_CENTAVOS=500000
# Cobranças emitidas por conversa por dia; além disso, um atendente assume
PAGAMENTO_MAX_COBRANCAS_DIA=3
# Vencimento da cobrança no PSP = hoje + N dias
PAGAMENTO_DIAS_VENCIMENTO=3
# Fluxo de cobrança sem resposta do cliente expira (minutos)
PAGAMENTO_FLUXO_EXPIRA_MIN=60
# Modelo aprovado (013) para avisar "pagamento confirmado" com a janela de 24h fechada
#WA_TEMPLATE_PAGAMENTO_CONFIRMADO=pagamento_confirmado

# Simulador da API do TS Explorer (035) — `apps/tse-sim`, o dublê do ERP por HTTP.
# Sobe com `pnpm dev` em :3010 e NUNCA é exposto na internet (sem porta publicada
# no compose de produção, sem rota no Caddy). Ver docs/tse-api-setup.md.
TSE_SIM_PORT=3010
# Papel `tse_sim`: escreve nas tabelas físicas do erp_mock, cego para as views
# canônicas (quem lê o ERP pelo produto é o erp_ro). Em produção, a senha vem de
# TSE_SIM_DB_PASSWORD e o boot recusa a senha de dev.
TSE_SIM_DATABASE_URL=postgres://tse_sim:tse_sim_dev@localhost:5432/erp_mock
# Senha do papel, aplicada por `pnpm db:seed:erp` (o 04-sim-role.sql a lê por bind)
#TSE_SIM_DB_PASSWORD=
# Credenciais do /token: `login:senha:idPessoa`, separadas por vírgula.
# O idPessoa é quem o token representa no painel do cliente (ver escopo abaixo).
TSE_SIM_USERS=integracao:integracao:1
# D10 (risco nº 1 da frente demo): o painel do TSE pode resolver escopo pelo DONO
# DO TOKEN. `qualquer` = uma credencial lê qualquer contrato (o que a demo
# precisa); `token` = só os contratos do titular dono do token (o cenário ruim).
TSE_SIM_PAINEL_ESCOPO=qualquer
# Caos controlado para exercitar timeout e retry do adapter (036): atraso fixo
# por resposta e falhas 500 em basis points (100 = 1%)
TSE_SIM_LATENCIA_MS=0
TSE_SIM_FALHA_BPS=0
