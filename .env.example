# Copie para .env (nunca commitar o .env)
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Banco do produto (rw) — ver infra/postgres/init/01-init.sql
DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:5432/app

# ERP simulado (somente leitura, só enxerga as views canônicas)
ERP_DATABASE_URL=postgres://erp_ro:erp_ro_dev@localhost:5432/erp_mock

# Admin do erp_mock — SÓ para tooling dev (db:seed:erp aplica schema e seed)
ERP_MOCK_ADMIN_URL=postgres://postgres:postgres@localhost:5432/erp_mock

# Config da implantação (1 cliente na POC)
CLIENT_CONFIG_PATH=configs/demo/client.yaml

# WhatsApp Meta Cloud API — ver docs/meta-setup.md
# Simulador dev (plano B da demo): habilita POST /dev/inbound e GET /dev/events
DEV_SIMULATOR=true
# Token arbitrário usado na verificação do webhook (GET /webhook)
WA_VERIFY_TOKEN=dev-verify-token
# App secret do app Meta (valida X-Hub-Signature-256 do POST /webhook)
WA_APP_SECRET=dev-app-secret
# Credenciais da Cloud API; ausentes ⇒ envio vira log-only (dev/simulador)
#WA_ACCESS_TOKEN=
#WA_PHONE_NUMBER_ID=
# Silêncio (ms) que fecha um turno no debouncer (#46: base 10s; a janela se
# adapta — mensagem com fecho ?!. espera 0.6x, continuação/curta espera 1.5x)
WA_DEBOUNCE_MS=10000

# Provedor LLM (endpoint OpenAI-compatible: OpenAI, OpenRouter, vLLM on-prem...)
# Ausente ⇒ agente responde fallback honesto (simulador continua funcionando)
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_API_KEY=
#LLM_MODEL=
#EMBEDDING_MODEL=
# Dimensão dos embeddings (default 1536 = text-embedding-3-small); precisa casar
# com o EMBEDDING_MODEL — o índice HNSW e a validação do store usam esse valor
#EMBEDDING_DIM=1536
# Preço por 1M de tokens (custo estimado em /metricas; unidade livre, ex.: USD)
LLM_PRECO_IN_POR_1M=0
LLM_PRECO_OUT_POR_1M=0
# Timeout do turno do agente (ms) e cadência do resumo rolante (turnos)
AGENT_TURN_TIMEOUT_MS=60000
AGENT_RESUMO_A_CADA_TURNOS=4

# Base de conhecimento (008): pasta de .md ingerida por `pnpm kb:ingest`
KB_DIR=kb
