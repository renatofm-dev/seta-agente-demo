# Copie para .env (nunca commitar o .env)
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Banco do produto (rw) — ver infra/postgres/init/01-init.sql
DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:5432/app

# ERP simulado (somente leitura, só enxerga as views canônicas)
ERP_DATABASE_URL=postgres://erp_ro:erp_ro_dev@localhost:5432/erp_mock

# Admin do erp_mock — SÓ para tooling dev (db:seed:erp aplica schema e seed)
ERP_MOCK_ADMIN_URL=postgres://postgres:postgres@localhost:5432/erp_mock

# Config da implantação (1 cliente na POC)
CLIENT_CONFIG_PATH=configs/demo/client.yaml

# WhatsApp Meta Cloud API — ver docs/meta-setup.md
# Simulador dev (plano B da demo): habilita POST /dev/inbound e GET /dev/events
DEV_SIMULATOR=true
# Token arbitrário usado na verificação do webhook (GET /webhook)
WA_VERIFY_TOKEN=dev-verify-token
# App secret do app Meta (valida X-Hub-Signature-256 do POST /webhook)
WA_APP_SECRET=dev-app-secret
# Credenciais da Cloud API; ausentes ⇒ envio vira log-only (dev/simulador)
#WA_ACCESS_TOKEN=
#WA_PHONE_NUMBER_ID=
# Silêncio (ms) que fecha um turno no debouncer
WA_DEBOUNCE_MS=4000
